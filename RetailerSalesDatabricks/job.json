          "notebook_path": "YOUR_NOTEBOOK_PATH",
          "base_parameters": {
            "Geography": "YOUR_GEOGRAPHY",
            "DateFrom": "YYYY-MM-DD",
            "DateTo": "YYYY-MM-DD",
            "requestId": "YOUR_REQUEST_ID"
          },
          "source": "WORKSPACE"
        },
        "timeout_seconds": 0,
        "disabled": false
      }
    ],
    "format": "MULTI_TASK",
    "queue": {
      "enabled": true
    },
    "performance_target": "PERFORMANCE_OPTIMIZED"
  }
}
